# apps/api env template — copy to apps/api/.env for local dev (gitignored).
DATABASE_URL=postgresql://reforge:reforge@localhost:5433/reforge
REDIS_URL=redis://localhost:6379
PORT=3001
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d
OPENROUTER_API_KEY=
OPENROUTER_CLASSIFY_MODEL=openai/gpt-4o-mini
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL_BASE=
API_KEY_HASH_SALT_ROUNDS=10
WEB_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT=1mb
RATELIMIT_MAX_REQUESTS=100
LOGS_DIR=./logs
